<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% assign cur_lang = page.lang | default: 'en' %}
      {% if page.lang_ref == 'home' %}
        <!-- SMART logo -->
        <a class="navbar-brand smart-logo" href="https://smart.org.cn" target="_blank" rel="noopener noreferrer">
          {% if cur_lang == 'zh' %}
            <img src="{{ '/assets/img/smart-logo-zh.png' | relative_url }}" alt="SMART" />
          {% else %}
            <img src="{{ '/assets/img/smart-logo-en.png' | relative_url }}" alt="SMART" />
          {% endif %}
        </a>
        {% if site.enable_navbar_social %}
          <!-- Social Icons -->
          <div class="navbar-brand social">{% include social.liquid %}</div>
        {% endif %}
      {% endif %}

      {% assign other_lang = 'zh' %}
      {% if cur_lang == 'zh' %}
        {% assign other_lang = 'en' %}
      {% endif %}

      <!-- Language toggle: jumps to the sibling of the current page (same lang_ref, other lang) -->
      {% assign lang_toggle_url = null %}
      {% if page.lang_ref %}
        {% for p in site.pages %}
          {% assign p_lang = p.lang | default: 'en' %}
          {% if p.lang_ref == page.lang_ref and p_lang == other_lang %}
            {% assign lang_toggle_url = p.url %}
          {% endif %}
        {% endfor %}
      {% endif %}
      {% if lang_toggle_url == null %}
        {% for p in site.pages %}
          {% assign p_lang = p.lang | default: 'en' %}
          {% if p.lang_ref == 'home' and p_lang == other_lang %}
            {% assign lang_toggle_url = p.url %}
          {% endif %}
        {% endfor %}
      {% endif %}
      {% assign lang_label = 'EN' %}
      {% if other_lang == 'zh' %}
        {% assign lang_label = '中文' %}
      {% endif %}

      <div class="mobile-nav-controls ml-auto">
        <a class="nav-link lang-toggle-btn mobile-lang-toggle" href="{{ lang_toggle_url | relative_url }}">{{ lang_label }}</a>

        <!-- Navbar Toggle -->
        <button
          class="navbar-toggler collapsed"
          type="button"
          data-toggle="collapse"
          data-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar top-bar"></span>
          <span class="icon-bar middle-bar"></span>
          <span class="icon-bar bottom-bar"></span>
        </button>
      </div>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <!-- Pages, filtered to the current page's language -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% assign p_lang = p.lang | default: 'en' %}
            {% if p.nav and p.autogen == null and p_lang == cur_lang %}
              {% assign parent_link = p.permalink | remove: 'index.html' %}
              {% capture is_active %}false{% endcapture %}
              {% if parent_link == '/' %}
                {% if page.url == '/' %}
                  {% capture is_active %}true{% endcapture %}
                {% endif %}
              {% elsif page.url contains parent_link %}
                {% capture is_active %}true{% endcapture %}
              {% endif %}
              <li class="nav-item {% if is_active == 'true' %}active{% endif %}">
                {%- if p.permalink contains '://' -%}
                  {%- assign url = p.permalink -%}
                {%- elsif p.permalink contains '/blog/' -%}
                  {%- assign url = '/blog/' -%}
                {%- else -%}
                  {%- assign url = p.url -%}
                {%- endif %}
                <a class="nav-link" href="{{ url | relative_url }}">
                  {{- p.title }}
                  {% if is_active == 'true' %}
                    <span class="sr-only">(current)</span>
                  {% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}

          <li class="nav-item lang-toggle-item desktop-lang-toggle">
            <a class="nav-link lang-toggle-btn" href="{{ lang_toggle_url | relative_url }}">{{ lang_label }}</a>
          </li>
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
