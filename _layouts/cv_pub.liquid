---
---
<div class="row">
  <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
    <table class="table-cv">
      <tbody>
        <tr>
          <td>
            <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">{{ entry.year }}</span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
    <h6 class="title font-weight-bold ml-1 ml-md-4">
      {% if entry.doi %}
        <a href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener noreferrer">{{ entry.title }}</a>
      {% else %}
        {{ entry.title }}
      {% endif %}
    </h6>
    <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ entry.journal }}</h6>
    <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">
      {%- assign authors = entry.author_array -%}
      {%- assign total = authors | size -%}
      {%- for a in authors -%}
        {%- unless forloop.first %}, {% endunless -%}
        {%- if forloop.last and total > 1 %}and {% endif -%}
        {%- include bib_author.liquid author=a -%}
      {%- endfor -%}
    </h6>
    {% if entry.code or entry.data or entry.website %}
      <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-weight: bold">
        {% if entry.code %}<a href="{{ entry.code }}" target="_blank" rel="noopener noreferrer">[Code]</a>{% endif %}
        {% if entry.data %}&emsp;<a href="{{ entry.data }}" target="_blank" rel="noopener noreferrer">[Data]</a>{% endif %}
        {% if entry.website %}&emsp;<a href="{{ entry.website }}" target="_blank" rel="noopener noreferrer">[Website]</a>{% endif %}
      </h6>
    {% endif %}
  </div>
</div>
